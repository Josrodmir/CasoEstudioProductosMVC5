<!DOCTYPE html>
<html lang="es"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title>@ViewBag.Title · Mercado Claro</title><style>
:root{--ink:#172033;--muted:#657086;--line:#e6eaf0;--blue:#155eef;--blue-dark:#0d47c8;--bg:#f6f8fc;--green:#067647;--red:#b42318;--card:#fff}*{box-sizing:border-box}body{margin:0;color:var(--ink);background:var(--bg);font:15px/1.5 "Segoe UI",Arial,sans-serif}.topbar{background:#101828;color:#fff}.topbar-inner{max-width:1180px;margin:auto;min-height:68px;display:flex;align-items:center;justify-content:space-between;padding:0 28px}.brand{color:#fff;text-decoration:none;font-size:18px;font-weight:800;letter-spacing:-.3px}.brand span{color:#84adff}.nav-link{color:#d0d5dd;text-decoration:none;margin-left:22px;font-weight:600}.nav-link:hover{color:#fff}.main{max-width:1180px;margin:38px auto 56px;padding:0 28px}h1{font-size:30px;letter-spacing:-.8px;margin:0}h2{margin-top:0}.eyebrow{color:var(--blue);text-transform:uppercase;font-size:12px;letter-spacing:1.2px;font-weight:800;margin:0 0 5px}.page-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:26px}.page-head p{color:var(--muted);margin:5px 0 0}.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:24px;box-shadow:0 2px 5px rgba(16,24,40,.03)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:10px 15px;background:var(--blue);color:#fff;text-decoration:none;border:1px solid var(--blue);border-radius:8px;font-weight:700;cursor:pointer;font:inherit}.btn:hover{background:var(--blue-dark);border-color:var(--blue-dark)}.btn.secondary{color:#344054;background:#fff;border-color:#d0d5dd}.btn.danger{background:var(--red);border-color:var(--red)}.btn-link{color:var(--blue);font-weight:700;text-decoration:none}.btn-link:hover{text-decoration:underline}.toolbar{display:flex;align-items:center;gap:12px;margin-bottom:18px}.toolbar form{display:flex;gap:8px;flex:1}input,select{width:100%;border:1px solid #cbd5e1;border-radius:8px;padding:10px 12px;color:var(--ink);background:#fff;font:inherit}input:focus,select:focus{outline:3px solid #dbe7ff;border-color:var(--blue)}table{width:100%;border-collapse:collapse}th{color:#475467;font-size:12px;text-transform:uppercase;letter-spacing:.45px;background:#f9fafb}th,td{padding:14px 16px;text-align:left;border-bottom:1px solid var(--line)}tr:last-child td{border-bottom:0}.actions{white-space:nowrap}.actions a{margin-right:12px}.badge{display:inline-block;padding:4px 9px;border-radius:999px;font-size:12px;font-weight:800}.badge.weight{color:#6941c6;background:#f4f3ff}.badge.unit{color:#026aa2;background:#f0f9ff}.badge.active{color:var(--green);background:#ecfdf3}.badge.inactive{color:#667085;background:#f2f4f7}.field{margin:16px 0}.field label{display:block;margin-bottom:6px;font-weight:700}.error{color:var(--red);font-size:13px}.ok{color:#05603a;background:#ecfdf3;border:1px solid #abefc6;border-radius:10px;padding:12px 15px;margin-bottom:20px}.detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.detail-item{padding:14px;border-radius:10px;background:#f8fafc}.detail-item small{display:block;color:var(--muted)}.detail-item strong{display:block;margin-top:3px;font-size:17px}@@media(max-width:720px){.topbar-inner,.main{padding-left:18px;padding-right:18px}.page-head,.toolbar,.toolbar form{align-items:stretch;flex-direction:column}.toolbar .btn{width:100%}table{min-width:760px}.table-wrap{overflow:auto}.detail-grid{grid-template-columns:1fr}}
</style></head><body><header class="topbar"><div class="topbar-inner"><a class="brand" href="@Url.Action("Index", "Productos")">mercado<span>claro</span></a><nav><a class="nav-link" href="@Url.Action("Index", "Productos")">Inventario</a><a class="nav-link" href="@Url.Action("Create", "Productos")">Nuevo producto</a></nav></div></header><main class="main">@if (TempData["Ok"] != null) { <div class="ok">@TempData["Ok"]</div> } @RenderBody()</main></body></html>
