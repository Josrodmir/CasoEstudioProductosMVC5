@model IEnumerable<CasoEstudioProductosMVC5.Models.Producto>
@{ ViewBag.Title = "Productos"; }<h1>Productos</h1><form method="get"><input name="buscar" value="@ViewBag.Buscar" placeholder="Código, nombre o categoría"/><button class="btn">Buscar</button> @Html.ActionLink("Limpiar", "Index")</form><p>@Html.ActionLink("+ Nuevo producto", "Create", null, new { @class = "btn" })</p><table><tr><th>Código</th><th>Nombre</th><th>Categoría</th><th>Precio</th><th>Existencia</th><th>Estado</th><th></th></tr>@foreach(var p in Model){<tr><td>@p.Codigo</td><td>@p.Nombre</td><td>@p.Categoria</td><td>@p.Precio.ToString("C")</td><td>@p.Existencia</td><td>@(p.Activo ? "Activo" : "Inactivo")</td><td>@Html.ActionLink("Ver", "Details", new{id=p.Id}) | @Html.ActionLink("Editar", "Edit", new{id=p.Id}) | @Html.ActionLink("Eliminar", "Delete", new{id=p.Id})</td></tr>}</table>
