@model IEnumerable<CasoEstudioProductosMVC5.Models.Producto>
@{ ViewBag.Title = "Inventario"; }
<section class="page-head"><div><p class="eyebrow">Administración de inventario</p><h1>Productos</h1><p>Consulta, registra y actualiza los artículos de la tienda.</p></div>@Html.ActionLink("+ Nuevo producto", "Create", null, new { @class = "btn" })</section>
<section class="card"><div class="toolbar"><form method="get"><input name="buscar" value="@ViewBag.Buscar" placeholder="Buscar por código, nombre o categoría" aria-label="Buscar productos" /><button class="btn" type="submit">Buscar</button></form>@Html.ActionLink("Limpiar", "Index", null, new { @class = "btn secondary" })</div><div class="table-wrap"><table><thead><tr><th>Producto</th><th>Tipo de venta</th><th>Categoría</th><th>Precio</th><th>Existencia</th><th>Estado</th><th>Acciones</th></tr></thead><tbody>@foreach (var p in Model) { <tr><td><strong>@p.Nombre</strong><br /><small>@p.Codigo</small></td><td><span class="badge @(p.TipoProducto == CasoEstudioProductosMVC5.Models.TipoProducto.PorPeso ? "weight" : "unit")">@(p.TipoProducto == CasoEstudioProductosMVC5.Models.TipoProducto.PorPeso ? "Por peso" : "Por unidad")</span></td><td>@p.Categoria</td><td><strong>@p.Precio.ToString("C")</strong><br /><small>@(p.TipoProducto == CasoEstudioProductosMVC5.Models.TipoProducto.PorPeso ? "por kg" : "por unidad")</small></td><td>@p.Existencia</td><td><span class="badge @(p.Activo ? "active" : "inactive")">@(p.Activo ? "Activo" : "Inactivo")</span></td><td class="actions">@Html.ActionLink("Ver", "Details", new { id = p.Id }, new { @class = "btn-link" }) @Html.ActionLink("Editar", "Edit", new { id = p.Id }, new { @class = "btn-link" }) @Html.ActionLink("Eliminar", "Delete", new { id = p.Id }, new { @class = "btn-link" })</td></tr> }</tbody></table></div></section>
