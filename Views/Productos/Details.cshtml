@model CasoEstudioProductosMVC5.Models.Producto
@{ ViewBag.Title = "Detalle"; }
<section class="page-head"><div><p class="eyebrow">Ficha de producto</p><h1>@Model.Nombre</h1><p>@Model.Codigo · @Model.Categoria</p></div><div>@Html.ActionLink("Editar", "Edit", new { id = Model.Id }, new { @class = "btn" }) @Html.ActionLink("Eliminar", "Delete", new { id = Model.Id }, new { @class = "btn danger" })</div></section>
<div class="card"><div class="detail-grid"><div class="detail-item"><small>Tipo de venta</small><strong>@(Model.TipoProducto == CasoEstudioProductosMVC5.Models.TipoProducto.PorPeso ? "Por peso (kg)" : "Por unidad")</strong></div><div class="detail-item"><small>Precio</small><strong>@Model.Precio.ToString("C") @(Model.TipoProducto == CasoEstudioProductosMVC5.Models.TipoProducto.PorPeso ? "por kg" : "por unidad")</strong></div><div class="detail-item"><small>Existencia disponible</small><strong>@Model.Existencia</strong></div><div class="detail-item"><small>Estado</small><strong>@(Model.Activo ? "Activo" : "Inactivo")</strong></div></div><p style="margin-bottom:0;margin-top:24px">@Html.ActionLink("← Volver al inventario", "Index", null, new { @class = "btn-link" })</p></div>
