@model CasoEstudioProductosMVC5.Models.Producto
<div class="field">@Html.LabelFor(m => m.Codigo)@Html.TextBoxFor(m => m.Codigo, new { maxlength = 12, placeholder = "Ej. UNI-001" })@Html.ValidationMessageFor(m => m.Codigo, "", new { @class = "error" })</div>
<div class="field">@Html.LabelFor(m => m.Nombre)@Html.TextBoxFor(m => m.Nombre, new { maxlength = 80, placeholder = "Nombre del producto" })@Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "error" })</div>
<div class="field">@Html.LabelFor(m => m.Categoria)@Html.TextBoxFor(m => m.Categoria, new { maxlength = 40, placeholder = "Ej. Abarrotes" })@Html.ValidationMessageFor(m => m.Categoria, "", new { @class = "error" })</div>
<div class="field">@Html.LabelFor(m => m.TipoProducto)@Html.EnumDropDownListFor(m => m.TipoProducto)@Html.ValidationMessageFor(m => m.TipoProducto, "", new { @class = "error" })</div>
<div class="field">@Html.LabelFor(m => m.Precio)@Html.TextBoxFor(m => m.Precio, new { type = "number", step = "0.01", min = "0.01" })@Html.ValidationMessageFor(m => m.Precio, "", new { @class = "error" })</div>
<div class="field">@Html.LabelFor(m => m.Existencia)@Html.TextBoxFor(m => m.Existencia, new { type = "number", min = "0", max = "9999" })@Html.ValidationMessageFor(m => m.Existencia, "", new { @class = "error" })</div>
<div class="field">@Html.CheckBoxFor(m => m.Activo) @Html.LabelFor(m => m.Activo)</div>
