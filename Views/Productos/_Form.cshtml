@model CasoEstudioProductosMVC5.Models.Producto
<div class="field">@Html.LabelFor(m=>m.Codigo)<br/>@Html.TextBoxFor(m=>m.Codigo,new{maxlength=12})<br/>@Html.ValidationMessageFor(m=>m.Codigo,"",new{@class="error"})</div><div class="field">@Html.LabelFor(m=>m.Nombre)<br/>@Html.TextBoxFor(m=>m.Nombre,new{maxlength=80})<br/>@Html.ValidationMessageFor(m=>m.Nombre,"",new{@class="error"})</div><div class="field">@Html.LabelFor(m=>m.Categoria)<br/>@Html.TextBoxFor(m=>m.Categoria,new{maxlength=40})<br/>@Html.ValidationMessageFor(m=>m.Categoria,"",new{@class="error"})</div><div class="field">@Html.LabelFor(m=>m.Precio)<br/>@Html.TextBoxFor(m=>m.Precio)<br/>@Html.ValidationMessageFor(m=>m.Precio,"",new{@class="error"})</div><div class="field">@Html.LabelFor(m=>m.Existencia)<br/>@Html.TextBoxFor(m=>m.Existencia)<br/>@Html.ValidationMessageFor(m=>m.Existencia,"",new{@class="error"})</div><div class="field">@Html.CheckBoxFor(m=>m.Activo) @Html.LabelFor(m=>m.Activo)</div>
